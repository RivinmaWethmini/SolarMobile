<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvSummaryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Booking Summary"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvActionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Action Completed Successfully"
            android:textColor="@color/emerald_approved"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <!-- Summary Details Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="16dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Reservation ID -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reservation Reference"
                    android:textColor="@color/slate_text_dim"
                    android:textSize="11sp"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/tvSummaryId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#RES-1002"
                    android:textColor="@color/accent_solar"
                    android:textSize="18sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Prosumer NIC -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prosumer NIC"
                    android:textColor="@color/slate_text_dim"
                    android:textSize="11sp"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/tvSummaryNic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="200012345678"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <!-- Node ID -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assigned Microgrid Node"
                    android:textColor="@color/slate_text_dim"
                    android:textSize="11sp"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/tvSummaryNode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NODE-COLOMBO-CENTRAL"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <!-- Energy Capacity -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reserved Capacity"
                    android:textColor="@color/slate_text_dim"
                    android:textSize="11sp"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/tvSummaryCapacity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="35.0 kW/h"
                    android:textColor="@color/accent_solar"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Scheduled Time Window -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scheduled Time Slot"
                    android:textColor="@color/slate_text_dim"
                    android:textSize="11sp"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/tvSummaryTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2026-09-20 09:00 - 11:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />

                <!-- Status Badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Approval Status"
                    android:textColor="@color/slate_text_dim"
                    android:textSize="11sp"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/tvSummaryStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pending"
                    android:textColor="@color/amber_pending"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- View QR Code Button (Visible when Approved) -->
        <Button
            android:id="@+id/btnViewQrCode"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="@color/emerald_approved"
            android:text="View Dispatch QR Code"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Cancel Booking Button (12-Hour Rule Enforced) -->
        <Button
            android:id="@+id/btnCancelBooking"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#EF4444"
            android:text="Cancel Reservation (12-Hr Rule)"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Back to Dashboard -->
        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#334155"
            android:text="Back to Dashboard"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>

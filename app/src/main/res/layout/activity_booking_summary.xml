<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Back Navigation Row -->
        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back to Dashboard"
                android:textColor="@color/yellow_primary"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:fontFamily="@font/outfit"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Header Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSummaryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reservation Summary"
                    android:textColor="@color/text_white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:id="@+id/tvActionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Action Completed Successfully"
                    android:textColor="@color/emerald_approved"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_solar_logo"
                android:contentDescription="Solar Logo" />
        </RelativeLayout>

        <!-- Reference & Status Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvSummaryId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="#RES-000000"
                android:textColor="@color/yellow_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSummaryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill"
                android:fontFamily="@font/outfit"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="Pending"
                android:textColor="@color/text_dark_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Details Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/outfit"
            android:text="Reservation details"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_dark" />

        <!-- Detail Item: Solar Node -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:text="Assigned solar node"
                android:textColor="@color/text_light_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSummaryNode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:layout_marginTop="2dp"
                android:text="Colombo North Solar Hub"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_dark" />

        <!-- Detail Item: Prosumer Identifier -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:text="Prosumer identifier (NIC)"
                android:textColor="@color/text_light_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSummaryNic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:layout_marginTop="2dp"
                android:text="200012345678"
                android:textColor="@color/text_light_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_dark" />

        <!-- Detail Item: Scheduled Window -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:text="Scheduled trading window"
                android:textColor="@color/text_light_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSummaryTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:layout_marginTop="2dp"
                android:text="09:00 - 11:00"
                android:textColor="@color/yellow_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_dark" />

        <!-- Detail Item: Reserved Energy Capacity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:text="Reserved energy capacity"
                android:textColor="@color/text_light_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSummaryCapacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:layout_marginTop="2dp"
                android:text="20.0 kWh"
                android:textColor="@color/emerald_approved"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_dark"
            android:layout_marginBottom="24dp" />

        <!-- Actions Section -->

        <!-- View QR Code Button (Visible when Approved) -->
        <Button
            android:id="@+id/btnViewQrCode"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_yellow_pill"
            android:text="View Dispatch QR Code →"
            android:textColor="@color/text_dark_primary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:fontFamily="@font/outfit"
            android:textAllCaps="false"
            app:backgroundTint="@null"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Modify Booking Button -->
        <Button
            android:id="@+id/btnModifyBooking"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_pill_dark"
            android:text="Modify Reservation →"
            android:textColor="@color/yellow_primary"
            android:textStyle="bold"
            android:textSize="13sp"
            android:fontFamily="@font/outfit"
            android:textAllCaps="false"
            app:backgroundTint="@null"
            android:layout_marginBottom="10dp" />

        <!-- Cancel Booking Button -->
        <Button
            android:id="@+id/btnCancelBooking"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_text_action"
            android:text="Cancel Reservation"
            android:textColor="#EF4444"
            android:textStyle="bold"
            android:textSize="13sp"
            android:fontFamily="@font/outfit"
            android:textAllCaps="false"
            app:backgroundTint="@null"
            android:layout_marginBottom="10dp" />

        <!-- Back to Dashboard -->
        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_text_action"
            android:text="Back to Dashboard"
            android:textColor="@color/text_light_secondary"
            android:textSize="13sp"
            android:fontFamily="@font/outfit"
            android:textAllCaps="false"
            app:backgroundTint="@null" />

    </LinearLayout>
</ScrollView>

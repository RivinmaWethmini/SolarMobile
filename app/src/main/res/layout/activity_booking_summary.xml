<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSummaryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reservation Summary"
                    android:textColor="@color/text_white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:id="@+id/tvActionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Action Completed Successfully"
                    android:textColor="@color/emerald_approved"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_solar_logo"
                android:contentDescription="Solar Logo" />
        </RelativeLayout>

        <!-- Summary Details Card (Obsidian Dark with Yellow Accent) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dark_card"
            android:orientation="vertical"
            android:padding="22dp"
            android:layout_marginBottom="24dp">

            <!-- Reservation Reference ID -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESERVATION REFERENCE"
                android:textColor="@color/text_light_muted"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textAllCaps="false"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSummaryId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#RES-1002"
                android:textColor="@color/yellow_primary"
                android:textSize="20sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="14dp" />

            <!-- Prosumer NIC -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROSUMER IDENTIFIER"
                android:textColor="@color/text_light_muted"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textAllCaps="false"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSummaryNic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="200012345678"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:fontFamily="@font/outfit"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="14dp" />

            <!-- Node ID -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASSIGNED MICROGRID NODE"
                android:textColor="@color/text_light_muted"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textAllCaps="false"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSummaryNode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NODE-COLOMBO-CENTRAL"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:fontFamily="@font/outfit"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="14dp" />

            <!-- Energy Capacity -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESERVED CAPACITY"
                android:textColor="@color/text_light_muted"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textAllCaps="false"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSummaryCapacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="35.0 kW/h"
                android:textColor="@color/yellow_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/outfit"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="14dp" />

            <!-- Scheduled Time Window -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCHEDULED TIME WINDOW"
                android:textColor="@color/text_light_muted"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textAllCaps="false"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSummaryTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-09-20 09:00 - 11:00"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:fontFamily="@font/outfit"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="14dp" />

            <!-- Status Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISPATCH STATUS"
                android:textColor="@color/text_light_muted"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textAllCaps="false"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSummaryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textColor="@color/yellow_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/outfit"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- View QR Code Button (Visible when Approved) -->
        <Button
            android:id="@+id/btnViewQrCode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_yellow_pill"
            android:text="View Dispatch QR Code"
            android:textColor="@color/text_dark_primary"
            android:textStyle="bold"
            android:textSize="13sp"
            android:fontFamily="@font/outfit"
            app:backgroundTint="@null"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Modify Booking Button -->
        <Button
            android:id="@+id/btnModifyBooking"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_pill_dark"
            android:text="Modify Reservation"
            android:textColor="@color/yellow_primary"
            android:textStyle="bold"
            android:textSize="13sp"
            android:fontFamily="@font/outfit"
            app:backgroundTint="@null"
            android:layout_marginBottom="12dp" />

        <!-- Cancel Booking Button (Cleaned text without assignment rule label) -->
        <Button
            android:id="@+id/btnCancelBooking"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_pill_dark"
            android:text="Cancel Reservation"
            android:textColor="#EF4444"
            android:textStyle="bold"
            android:textSize="13sp"
            android:fontFamily="@font/outfit"
            app:backgroundTint="@null"
            android:layout_marginBottom="12dp" />

        <!-- Back to Dashboard -->
        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_pill_dark"
            android:text="Back to Dashboard"
            android:textColor="@color/text_light_secondary"
            android:textSize="13sp"
            android:fontFamily="@font/outfit"
            app:backgroundTint="@null" />

    </LinearLayout>
</ScrollView>

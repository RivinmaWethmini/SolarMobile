<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="44dp"
            android:paddingBottom="24dp"
            android:background="@color/bg_dark_surface">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Reserve Energy Slot"
                android:textColor="@color/yellow_primary"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-bold"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book Energy Slot"
                android:textColor="@color/text_white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select microgrid node, date, and schedule window"
                android:textColor="@color/text_light_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Form Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Section: Microgrid Node -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MICROGRID NODE"
                android:textColor="@color/text_light_muted"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_dark_input"
                android:layout_marginBottom="20dp">

                <Spinner
                    android:id="@+id/spNodeSelector"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:popupBackground="@color/bg_dark_card" />
            </FrameLayout>

            <!-- Section: Reservation Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESERVATION DATE"
                android:textColor="@color/text_light_muted"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnSelectDate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_dark_input"
                android:text="📅  Pick Date"
                android:textColor="@color/text_white"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textSize="13sp"
                app:backgroundTint="@null"
                android:layout_marginBottom="20dp" />

            <!-- Section: Time Slot Pickers -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIME SLOT"
                android:textColor="@color/text_light_muted"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="20dp">

                <Button
                    android:id="@+id/btnSelectStartTime"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_dark_input"
                    android:text="🕒  09:00"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnSelectEndTime"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_dark_input"
                    android:text="🕒  11:00"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <!-- Section: Energy Amount -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENERGY CAPACITY (KW/H)"
                android:textColor="@color/text_light_muted"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etEnergyAmount"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_dark_input"
                android:hint="Enter power in kW/h (e.g. 25.0)"
                android:textColorHint="@color/text_light_muted"
                android:textColor="@color/text_white"
                android:inputType="numberDecimal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <!-- Submit Button (Yellow Pill) -->
            <Button
                android:id="@+id/btnSubmitBooking"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_yellow_pill"
                android:text="Confirm &amp; Reserve Slot"
                android:textColor="@color/text_dark_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:fontFamily="sans-serif-bold"
                app:backgroundTint="@null"
                android:layout_marginBottom="16dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                android:indeterminateTint="@color/yellow_primary" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>

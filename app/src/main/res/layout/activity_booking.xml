<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080D1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="48dp"
            android:paddingBottom="22dp"
            android:background="#0F172A">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Reserve Energy Slot"
                android:textColor="@color/accent_solar"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Booking"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select a node, date and time window"
                android:textColor="#475569"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- 7-Day Rule Warning -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1A1208"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:text="⚡ 7-Day Rule: Reservations must be scheduled within 7 days from today. Bookings beyond this window will be rejected by the server."
                    android:textColor="#D97706"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </androidx.cardview.widget.CardView>

            <!-- Section: Node -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MICROGRID NODE"
                android:textColor="#475569"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#131D2E"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="20dp">

                <Spinner
                    android:id="@+id/spNodeSelector"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@null"
                    android:padding="12dp"
                    android:popupBackground="#1E293B" />
            </androidx.cardview.widget.CardView>

            <!-- Section: Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESERVATION DATE"
                android:textColor="#475569"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnSelectDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#131D2E"
                android:text="📅  Pick Date"
                android:textColor="#CBD5E1"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:paddingStart="18dp"
                app:cornerRadius="12dp"
                android:layout_marginBottom="20dp" />

            <!-- Section: Time Pickers -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIME SLOT"
                android:textColor="#475569"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:layout_marginBottom="5dp" />

                    <Button
                        android:id="@+id/btnSelectStartTime"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:backgroundTint="#131D2E"
                        android:text="🕘 09:00"
                        android:textColor="#CBD5E1"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="End"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:layout_marginBottom="5dp" />

                    <Button
                        android:id="@+id/btnSelectEndTime"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:backgroundTint="#131D2E"
                        android:text="🕚 11:00"
                        android:textColor="#CBD5E1"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section: Energy Amount -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENERGY AMOUNT (kW/h)"
                android:textColor="#475569"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#131D2E"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="28dp">

                <EditText
                    android:id="@+id/etEnergyAmount"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@null"
                    android:textColor="#FFFFFF"
                    android:hint="e.g.  25.5"
                    android:textColorHint="#334155"
                    android:inputType="numberDecimal"
                    android:padding="14dp"
                    android:textSize="15sp" />
            </androidx.cardview.widget.CardView>

            <!-- Submit CTA Button -->
            <Button
                android:id="@+id/btnSubmitBooking"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:backgroundTint="@color/accent_solar"
                android:text="Submit Reservation Request"
                android:textColor="#0F172A"
                android:textStyle="bold"
                android:textSize="15sp"
                app:cornerRadius="14dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>

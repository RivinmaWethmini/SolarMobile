<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reserve Energy Slot"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Member 4: Node &amp; Date Picker Workflow"
            android:textColor="@color/accent_solar"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <!-- Rule Notice -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#2D2415"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="⚠️ 7-Day Rule: All energy slot reservations must be scheduled within 7 days from today."
                android:textColor="#FDE68A"
                android:textSize="12sp" />
        </androidx.cardview.widget.CardView>

        <!-- Node Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Microgrid Node"
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spNodeSelector"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#1E293B"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Date Picker Button -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reservation Date"
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnSelectDate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#1E293B"
            android:text="Pick Date (Within 7 Days)"
            android:textColor="#FFFFFF"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            app:cornerRadius="10dp"
            android:layout_marginBottom="16dp" />

        <!-- Time Picker Section (Start & End) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start Time"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/btnSelectStartTime"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:backgroundTint="#1E293B"
                    android:text="09:00 AM"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="End Time"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/btnSelectEndTime"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:backgroundTint="#1E293B"
                    android:text="11:00 AM"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="10dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Energy Capacity Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Energy Amount to Trade (kW/h)"
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etEnergyAmount"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#1E293B"
            android:textColor="#FFFFFF"
            android:hint="e.g. 25.5"
            android:textColorHint="#64748B"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSubmitBooking"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/accent_solar"
            android:text="Submit Reservation Request"
            android:textColor="#0F172A"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>

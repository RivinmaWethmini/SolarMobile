<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/bg_dark_card"
    app:cardCornerRadius="18dp"
    android:layout_marginBottom="12dp"
    app:cardElevation="0dp"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Left Status Accent Line -->
        <View
            android:id="@+id/viewStatusBar"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/yellow_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top Row: ID + Status Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvCardId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="#RES-SAMPLE"
                    android:textColor="@color/yellow_primary"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCardStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pending"
                    android:textColor="@color/text_dark_primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:background="@drawable/bg_yellow_pill"
                    android:textAllCaps="false"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <!-- Node Name -->
            <TextView
                android:id="@+id/tvCardNode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Colombo North Solar Hub"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/outfit"
                android:layout_marginBottom="6dp" />

            <!-- Energy + Time Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvCardEnergy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ 25.0 kW/h"
                    android:textColor="@color/yellow_primary"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCardTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:00 – 11:00"
                    android:textColor="@color/text_light_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit" />
            </LinearLayout>

            <!-- Action Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <Button
                    android:id="@+id/btnCardAction"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="View Pass →"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit"
                    android:background="@drawable/bg_pill_dark"
                    android:textColor="@color/yellow_primary"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fitsSystemWindows="false">

    <!-- Edge-to-Edge Hero Image Background -->
    <ImageView
        android:id="@+id/ivHeroImage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/hero_solar_microgrid"
        android:contentDescription="Solar Station"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/guidelineHeroBottom" />

    <!-- Dark Gradient Scrim overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_hero_scrim"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/guidelineHeroBottom" />

    <!-- Guideline for Hero Split (58% top, 42% bottom) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHeroBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.58" />

    <!-- Top Minimal Branding Bar with Safe Status Bar Insets -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_solar_logo"
            android:contentDescription="SolarRays Logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="SolarRays"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:fontFamily="@font/outfit_bold" />

        <TextView
            android:id="@+id/btnTopSignIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign In"
            android:textColor="@color/yellow_primary"
            android:textSize="13sp"
            android:fontFamily="@font/outfit_bold"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:background="@drawable/bg_dark_input" />
    </LinearLayout>

    <!-- Editorial Slide Content Area with Smooth Slide/Fade Animation -->
    <LinearLayout
        android:id="@+id/layoutSlideContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomControls">

        <!-- Headline -->
        <TextView
            android:id="@+id/tvSlideHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share clean solar power with your community"
            android:textColor="@color/text_white"
            android:textSize="26sp"
            android:lineSpacingMultiplier="1.15"
            android:fontFamily="@font/outfit_bold" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvSlideDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Connect your solar panels or buy green energy easily from your mobile phone."
            android:textColor="@color/text_light_secondary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.25"
            android:fontFamily="@font/outfit" />
    </LinearLayout>

    <!-- Bottom Action & Navigation Controls -->
    <LinearLayout
        android:id="@+id/layoutBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Slide Indicator Dots & Prev/Next Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <!-- 3 Dots Indicator -->
            <LinearLayout
                android:id="@+id/layoutDots"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/dot0"
                    android:layout_width="28dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_tab_selected" />

                <View
                    android:id="@+id/dot1"
                    android:layout_width="8dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_dark_input" />

                <View
                    android:id="@+id/dot2"
                    android:layout_width="8dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_dark_input" />
            </LinearLayout>

            <!-- Navigation Buttons: Prev & Next -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/btnPrevSlide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="← Prev"
                    android:textColor="@color/text_light_muted"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_semibold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp"
                    android:visibility="gone"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <TextView
                    android:id="@+id/btnNextSlide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Next →"
                    android:textColor="@color/yellow_primary"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>
        </LinearLayout>

        <!-- Create Account Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Create Account"
            android:textAllCaps="false"
            android:textColor="@color/bg_black"
            android:textSize="15sp"
            android:fontFamily="@font/outfit_bold"
            android:background="@drawable/btn_solar_gold"
            android:stateListAnimator="@null" />

        <!-- Sign In Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSignIn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Sign In"
            android:textAllCaps="false"
            android:textColor="@color/text_light_primary"
            android:textSize="14sp"
            android:fontFamily="@font/outfit_medium"
            android:background="@drawable/btn_dark_tactile"
            android:stateListAnimator="@null" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


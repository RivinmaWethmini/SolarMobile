<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="42dp">

        <!-- Top Header: Back Button + Clean Logo Tag -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="28dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:background="@drawable/bg_pill_dark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SolarRays"
                    android:textColor="@color/yellow_primary"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign In"
                    android:textColor="@color/text_light_secondary"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit" />
            </LinearLayout>

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_solar_logo"
                android:contentDescription="SolarRays Logo" />
        </LinearLayout>

        <!-- Headline & Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome back"
            android:textColor="@color/text_white"
            android:textSize="32sp"
            android:fontFamily="@font/outfit_bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:text="Sign in to view your energy slots, stations, and passes."
            android:textColor="@color/text_light_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/outfit"
            android:lineSpacingMultiplier="1.2" />

        <!-- Dual Mode Tab Switcher -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_dark_input"
            android:orientation="horizontal"
            android:padding="4dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tabPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Password Sign In"
                android:textColor="@color/bg_black"
                android:textSize="13sp"
                android:fontFamily="@font/outfit_bold"
                android:background="@drawable/bg_tab_selected" />

            <TextView
                android:id="@+id/tabOtp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Email Passcode (OTP)"
                android:textColor="@color/text_light_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/outfit_medium"
                android:background="@drawable/bg_tab_unselected" />
        </LinearLayout>

        <!-- ================================================================= -->
        <!-- CONTAINER 1: PASSWORD LOGIN FORM                                  -->
        <!-- ================================================================= -->
        <LinearLayout
            android:id="@+id/layoutPasswordForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Identifier (Email / Username) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email or username"
                android:textColor="@color/text_light_muted"
                android:textSize="12sp"
                android:fontFamily="@font/outfit_medium"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_dark_input"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="18dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_user"
                    android:contentDescription="User" />

                <EditText
                    android:id="@+id/etIdentifier"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:hint="Enter email or username"
                    android:textColorHint="@color/text_light_muted"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit"
                    android:inputType="textEmailAddress|text"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="@color/text_light_muted"
                android:textSize="12sp"
                android:fontFamily="@font/outfit_medium"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_dark_input"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lock"
                    android:contentDescription="Password" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:hint="Enter password"
                    android:textColorHint="@color/text_light_muted"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit"
                    android:inputType="textPassword"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Show"
                    android:textColor="@color/yellow_primary"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit_bold"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Submit Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubmitPasswordLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Sign In"
                android:textAllCaps="false"
                android:textColor="@color/bg_black"
                android:textSize="15sp"
                android:fontFamily="@font/outfit_bold"
                android:background="@drawable/btn_solar_gold"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- ================================================================= -->
        <!-- CONTAINER 2: EMAIL OTP LOGIN FORM                                 -->
        <!-- ================================================================= -->
        <LinearLayout
            android:id="@+id/layoutOtpForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Step 1: Request OTP -->
            <LinearLayout
                android:id="@+id/layoutOtpStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registered email or username"
                    android:textColor="@color/text_light_muted"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_medium"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_dark_input"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:layout_marginBottom="24dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_mail"
                        android:contentDescription="Mail" />

                    <EditText
                        android:id="@+id/etOtpIdentifier"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:background="@android:color/transparent"
                        android:hint="Enter registered username or email"
                        android:textColorHint="@color/text_light_muted"
                        android:textColor="@color/text_white"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit"
                        android:inputType="textEmailAddress|text"
                        android:singleLine="true" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSendOtp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Send Passcode to Email"
                    android:textAllCaps="false"
                    android:textColor="@color/bg_black"
                    android:textSize="15sp"
                    android:fontFamily="@font/outfit_bold"
                    android:background="@drawable/btn_solar_gold"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <!-- Step 2: 6-Digit Passcode Input -->
            <LinearLayout
                android:id="@+id/layoutOtpStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Dispatched Info Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dark_input"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Code Sent"
                        android:textColor="@color/yellow_primary"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit_bold" />

                    <TextView
                        android:id="@+id/tvMaskedEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sent to: sa•••••a@gmail.com"
                        android:textColor="@color/text_white"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit_medium"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/btnChangeOtpEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Change account / email"
                        android:textColor="@color/yellow_primary"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit_bold"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- 6 Passcode Boxes -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter 6-digit code"
                    android:textColor="@color/text_light_muted"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_medium"
                    android:layout_gravity="center"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="20dp">

                    <EditText
                        android:id="@+id/otpDigit1"
                        android:layout_width="44dp"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_otp_digit"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textColor="@color/yellow_primary"
                        android:textSize="20sp"
                        android:fontFamily="@font/outfit_bold" />

                    <EditText
                        android:id="@+id/otpDigit2"
                        android:layout_width="44dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_otp_digit"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textColor="@color/yellow_primary"
                        android:textSize="20sp"
                        android:fontFamily="@font/outfit_bold" />

                    <EditText
                        android:id="@+id/otpDigit3"
                        android:layout_width="44dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_otp_digit"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textColor="@color/yellow_primary"
                        android:textSize="20sp"
                        android:fontFamily="@font/outfit_bold" />

                    <EditText
                        android:id="@+id/otpDigit4"
                        android:layout_width="44dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_otp_digit"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textColor="@color/yellow_primary"
                        android:textSize="20sp"
                        android:fontFamily="@font/outfit_bold" />

                    <EditText
                        android:id="@+id/otpDigit5"
                        android:layout_width="44dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_otp_digit"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textColor="@color/yellow_primary"
                        android:textSize="20sp"
                        android:fontFamily="@font/outfit_bold" />

                    <EditText
                        android:id="@+id/otpDigit6"
                        android:layout_width="44dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_otp_digit"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:textColor="@color/yellow_primary"
                        android:textSize="20sp"
                        android:fontFamily="@font/outfit_bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvResendTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resend code in 60s"
                    android:textColor="@color/text_light_muted"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit"
                    android:layout_gravity="center"
                    android:layout_marginBottom="20dp" />

                <!-- Verify Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnVerifyOtp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Verify &amp; Sign In"
                    android:textAllCaps="false"
                    android:textColor="@color/bg_black"
                    android:textSize="15sp"
                    android:fontFamily="@font/outfit_bold"
                    android:background="@drawable/btn_solar_gold"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- Loading Spinner -->
        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:indeterminateTint="@color/yellow_primary"
            android:visibility="gone" />

        <!-- Footer / Register Link -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don't have an account?"
                android:textColor="@color/text_light_muted"
                android:textSize="13sp"
                android:fontFamily="@font/outfit" />

            <TextView
                android:id="@+id/btnGoToRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Create Account"
                android:textColor="@color/yellow_primary"
                android:textSize="13sp"
                android:fontFamily="@font/outfit_bold"
                android:padding="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prosumer Profile"
                android:textColor="@color/text_white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="@font/outfit" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage your solar energy profile"
                android:textColor="@color/text_light_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/outfit" />

        </LinearLayout>


        <!-- Profile Overview Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_dark_card"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROSUMER ACCOUNT"
                android:textColor="@color/yellow_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:fontFamily="@font/outfit" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name:"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/outfit" />

            <TextView
                android:id="@+id/tvNic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NIC:"
                android:textColor="@color/text_light_secondary"
                android:textSize="12sp"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/outfit" />

            <!-- Status -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Available"
                android:textColor="@color/yellow_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:background="@drawable/bg_pill_dark"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/outfit" />

        </LinearLayout>


        <!-- Energy Information -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENERGY INFORMATION"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/outfit" />


        <!-- Energy Cards Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="12dp">

            <!-- Solar Capacity -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_dark_card"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOLAR CAPACITY"
                    android:textColor="@color/text_light_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:id="@+id/tvSolarCapacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 kW"
                    android:textColor="@color/yellow_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/outfit" />

            </LinearLayout>


            <!-- Battery Capacity -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_dark_card"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BATTERY"
                    android:textColor="@color/text_light_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:id="@+id/tvBatteryCapacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 kWh"
                    android:textColor="@color/yellow_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/outfit" />

            </LinearLayout>

        </LinearLayout>


        <!-- Available Energy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_dark_card"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVAILABLE ENERGY"
                android:textColor="@color/text_light_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="@font/outfit" />

            <TextView
                android:id="@+id/tvAvailableEnergy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Available Energy: 0 kW"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="7dp"
                android:fontFamily="@font/outfit" />

        </LinearLayout>


        <!-- Trading Information -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENERGY TRADING"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/outfit" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="20dp">

            <!-- Price -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_dark_card"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRICE / kWh"
                    android:textColor="@color/text_light_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Price:"
                    android:textColor="@color/yellow_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/outfit" />

            </LinearLayout>


            <!-- Location -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_dark_card"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCATION"
                    android:textColor="@color/text_light_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Location:"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/outfit" />

            </LinearLayout>

        </LinearLayout>


        <!-- Actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT ACTIONS"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/outfit" />


        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Edit Profile"
            android:textColor="@color/bg_black"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/outfit"
            android:background="@drawable/bg_pill_dark"
            android:layout_marginBottom="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            app:backgroundTint="@null" />


        <Button
            android:id="@+id/btnDeactivateProfile"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Request Deactivation"
            android:textColor="@color/yellow_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/outfit"
            android:background="@drawable/bg_pill_dark"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            app:backgroundTint="@null" />

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prosumer Profile"
            android:textColor="@color/text_white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvNic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NIC:"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name:"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/tvSolarCapacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solar Capacity:"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/tvBatteryCapacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Battery Capacity:"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/tvAvailableEnergy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Available Energy:"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Price:"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location:"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status:"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:padding="10dp" />

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:orientation="vertical">

    <!-- Header & Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="44dp"
        android:paddingBottom="16dp"
        android:background="@color/bg_dark_surface">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_back"
                        android:contentDescription="Back"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Back to Dashboard"
                        android:textColor="@color/yellow_primary"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:fontFamily="@font/outfit"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Reservations"
                    android:textColor="@color/text_white"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_solar_logo"
                android:contentDescription="Solar Logo" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvReservationCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Track all active, scheduled, and past reservations"
            android:textColor="@color/text_light_secondary"
            android:textSize="12sp"
            android:fontFamily="@font/outfit"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Search Input -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_dark_input">

            <EditText
                android:id="@+id/etSearchBookings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Search by node, ID or status…"
                android:textColorHint="@color/text_light_muted"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:fontFamily="@font/outfit"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Filter Pills (Scrollable) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:background="@color/bg_black">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="All"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/outfit"
                android:background="@drawable/bg_yellow_pill"
                android:textColor="@color/text_dark_primary"
                android:layout_marginEnd="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnFilterPending"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Pending"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/outfit"
                android:background="@drawable/bg_pill_dark"
                android:textColor="@color/text_light_secondary"
                android:layout_marginEnd="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnFilterApproved"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Approved"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/outfit"
                android:background="@drawable/bg_pill_dark"
                android:textColor="@color/text_light_secondary"
                android:layout_marginEnd="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnFilterCancelled"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Cancelled"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/outfit"
                android:background="@drawable/bg_pill_dark"
                android:textColor="@color/text_light_secondary"
                android:layout_marginEnd="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnFilterRejected"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Rejected"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/outfit"
                android:background="@drawable/bg_pill_dark"
                android:textColor="@color/text_light_secondary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:backgroundTint="@null" />
        </LinearLayout>
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:indeterminateTint="@color/yellow_primary"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />

    <!-- Reservation List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBookings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

    <!-- Empty State Container -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="28dp">

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Reservations Found"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/outfit" />

        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="There are no energy slot reservations matching your criteria."
            android:textColor="@color/text_light_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnRetryLoad"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_yellow_pill"
            android:text="Retry Connection"
            android:textColor="@color/text_dark_primary"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            app:backgroundTint="@null"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>

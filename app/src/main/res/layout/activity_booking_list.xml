<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080D1A"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:background="#0F172A">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀️  My Reservations"
            android:textColor="@color/accent_solar"
            android:textSize="13sp"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Booking History"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending, approved &amp; historical records"
            android:textColor="#475569"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp" />

        <!-- Search Box -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <EditText
                android:id="@+id/etSearchBookings"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@null"
                android:hint="🔍  Search by Node, ID or Status..."
                android:textColorHint="#334155"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:padding="12dp" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Filter Pills -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="#080D1A">

        <Button
            android:id="@+id/btnFilterAll"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="All"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/accent_solar"
            android:textColor="#0F172A"
            android:layout_marginEnd="6dp"
            app:cornerRadius="18dp" />

        <Button
            android:id="@+id/btnFilterPending"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Pending"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#131D2E"
            android:textColor="#64748B"
            android:layout_marginEnd="6dp"
            app:cornerRadius="18dp" />

        <Button
            android:id="@+id/btnFilterApproved"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Approved"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#131D2E"
            android:textColor="#64748B"
            app:cornerRadius="18dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" />

    <!-- Reservation List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBookings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

</LinearLayout>

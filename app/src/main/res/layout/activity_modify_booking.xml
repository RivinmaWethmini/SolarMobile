<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modify Reservation"
            android:textColor="@color/text_white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update energy allocation or schedule window"
            android:textColor="@color/yellow_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="22dp" />

        <!-- Read-Only Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dark_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESERVATION REFERENCE &amp; STATUS"
                android:textColor="@color/text_light_muted"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvModifyRef"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="#RES"
                    android:textColor="@color/yellow_primary"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvModifyStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pending"
                    android:textColor="@color/yellow_primary"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvModifyNic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prosumer: -"
                android:textColor="@color/text_light_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvModifyNode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Node: -"
                android:textColor="@color/text_light_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Editable Energy Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENERGY CAPACITY (KW/H)"
            android:textColor="@color/text_light_muted"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etModifyEnergy"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_dark_input"
            android:hint="Enter updated kW/h"
            android:textColorHint="@color/text_light_muted"
            android:textColor="@color/text_white"
            android:inputType="numberDecimal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Date Picker Button -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCHEDULED DATE"
            android:textColor="@color/text_light_muted"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSelectDate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_dark_input"
            android:text="📅  Pick New Date"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:gravity="start|center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textSize="13sp"
            app:backgroundTint="@null"
            android:layout_marginBottom="20dp" />

        <!-- Time Slot Buttons -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UPDATED TIME SLOT"
            android:textColor="@color/text_light_muted"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnSelectStartTime"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_dark_input"
                android:text="🕒  Start Time"
                android:textColor="@color/text_white"
                android:textStyle="bold"
                android:textSize="13sp"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnSelectEndTime"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_dark_input"
                android:text="🕒  End Time"
                android:textColor="@color/text_white"
                android:textStyle="bold"
                android:textSize="13sp"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSubmitModify"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_yellow_pill"
            android:text="Save &amp; Update Reservation"
            android:textColor="@color/text_dark_primary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:fontFamily="sans-serif-bold"
            app:backgroundTint="@null"
            android:layout_marginBottom="12dp" />

        <!-- Cancel Modification Button -->
        <Button
            android:id="@+id/btnCancelModification"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_pill_dark"
            android:text="Cancel &amp; Go Back"
            android:textColor="@color/text_light_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="@null"
            android:layout_marginBottom="16dp" />

        <ProgressBar
            android:id="@+id/pbModify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:indeterminateTint="@color/yellow_primary" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fitsSystemWindows="true">

    <!-- Subtle Radial Glow / Background Ambience -->
    <View
        android:id="@+id/viewGlowBg"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/bg_logo_glow"
        android:alpha="0.6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Centered Brand Animation Group -->
    <LinearLayout
        android:id="@+id/layoutSplashContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logo Frame with Pop-Up Animation -->
        <FrameLayout
            android:id="@+id/frameSplashLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:background="@drawable/bg_logo_glow"
            android:padding="20dp"
            android:elevation="8dp">

            <ImageView
                android:id="@+id/ivSplashLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_solar_logo"
                android:contentDescription="SolarRays Logo" />
        </FrameLayout>

        <!-- Brand Name: Solar Yellow (#FFD000) with Smooth Slide-Up -->
        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="SolarRays"
            android:textColor="@color/yellow_primary"
            android:textSize="38sp"
            android:letterSpacing="0.06"
            android:fontFamily="@font/outfit_bold" />

        <!-- Subtitle / Tagline -->
        <TextView
            android:id="@+id/tvSplashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Smart Solar Microgrid Platform"
            android:textColor="@color/text_light_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.04"
            android:fontFamily="@font/outfit_semibold" />
    </LinearLayout>

    <!-- Bottom Pulse Indicator & Loading Text -->
    <LinearLayout
        android:id="@+id/layoutSplashFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/pulseDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_circle_yellow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Connecting to solar network..."
            android:textColor="@color/text_light_muted"
            android:textSize="12sp"
            android:fontFamily="@font/outfit" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

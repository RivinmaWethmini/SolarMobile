<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_solar_logo"
            android:contentDescription="Solar Logo"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dispatch QR Pass"
            android:textColor="@color/text_white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="@font/outfit" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verified Prosumer Energy Dispatch Pass"
            android:textColor="@color/yellow_primary"
            android:textSize="12sp"
            android:fontFamily="@font/outfit"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="24dp" />

        <!-- Metadata Header Block -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <!-- Approved Status Pill -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Approved"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/outfit"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="@color/emerald_approved"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvQrNodeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/outfit"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvQrTimeWindow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/text_light_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/outfit"
                android:gravity="center"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- QR Card with Yellow Border Frame -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_qr_frame"
            android:padding="6dp"
            android:layout_marginBottom="24dp">

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/ivQrCode"
                        android:layout_width="240dp"
                        android:layout_height="240dp"
                        android:contentDescription="Dispatch QR Pass" />

                    <TextView
                        android:id="@+id/tvQrReservationRef"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#0F172A"
                        android:fontFamily="monospace"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Present this pass to the operator at the microgrid node to finalize energy transfer."
            android:textColor="@color/text_light_secondary"
            android:textSize="12sp"
            android:fontFamily="@font/outfit"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="24dp" />

        <!-- Verified Security Badge (Clean replacement for raw technical payload) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dark_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cryptographically Verified Pass"
                android:textColor="@color/yellow_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/outfit" />
        </LinearLayout>

        <!-- Raw Payload Hidden from User (Preserved for backward-compat without UI clutter) -->
        <LinearLayout
            android:id="@+id/layoutRawPayload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRawPayload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="{}"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCloseQr"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_yellow_pill"
            android:text="Close Pass Viewer"
            android:textColor="@color/text_dark_primary"
            android:textStyle="bold"
            android:textSize="13sp"
            android:fontFamily="@font/outfit"
            app:backgroundTint="@null" />

    </LinearLayout>
</ScrollView>

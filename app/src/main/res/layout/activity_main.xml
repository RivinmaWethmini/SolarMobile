<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="36dp">

        <!-- Top Header Bar (Avatar + Greeting + Notification Bell) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <!-- Profile Avatar & Greeting -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:src="@drawable/ic_solar_logo"
                    android:contentDescription="Solar Microgrid Logo" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good Morning 🌤️"
                        android:textColor="@color/text_light_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit" />

                    <TextView
                        android:id="@+id/tvUserNic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prosumer Portal"
                        android:textColor="@color/text_white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/outfit"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Notification Bell Icon Button with Indicator -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_dark">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/text_white" />

                <!-- Notification Dot -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_circle_yellow" />
            </FrameLayout>
        </RelativeLayout>

        <!-- Circular Energy Gauge Card (Matching Screen 2 of Reference Image) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginBottom="24dp">

            <!-- Progress Ring Background -->
            <View
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_circular_gauge" />

            <!-- Center Metrics -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Energy Usage"
                    android:textColor="@color/yellow_primary"
                    android:textSize="12sp"
                    android:letterSpacing="0.04"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="85%"
                    android:textColor="@color/text_white"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Solar Grid Active"
                    android:textColor="@color/text_light_muted"
                    android:textSize="10sp"
                    android:letterSpacing="0.05"
                    android:textAllCaps="false"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Bottom Floating Lightning Bolt Badge -->
            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/bg_circle_yellow">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_energy_bolt" />
            </FrameLayout>
        </RelativeLayout>

        <!-- Live Reservation Operational Status (Pending & Approved) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="24dp">

            <!-- Pending Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                app:cardBackgroundColor="@color/bg_dark_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvPendingCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/yellow_primary"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/outfit" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending Action"
                        android:textColor="@color/text_light_secondary"
                        android:textSize="11sp"
                        android:fontFamily="@font/outfit"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Approved Future Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                app:cardBackgroundColor="@color/bg_dark_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvApprovedFutureCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/emerald_approved"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/outfit" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Approved Slots"
                        android:textColor="@color/text_light_secondary"
                        android:textSize="11sp"
                        android:fontFamily="@font/outfit"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Devices Section Header (Matching Screen 2 of Reference Image) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Devices &amp; Subsystems"
                android:textColor="@color/text_white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/outfit" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="See More"
                android:textColor="@color/text_light_muted"
                android:textSize="12sp"
                android:fontFamily="@font/outfit" />
        </RelativeLayout>

        <!-- 2x2 Devices Grid (Matching Screen 2 of Reference Image) -->
        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="12dp">

            <!-- Device 1: Air Conditioner (Cream Card) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="115dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_cream_card"
                android:orientation="vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_ac" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Air Conditioner"
                    android:textColor="@color/text_dark_secondary"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="278 Kwh"
                    android:textColor="@color/text_dark_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Device 2: Computer / Inverter (Cream Card) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="115dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_cream_card"
                android:orientation="vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_computer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Computer"
                    android:textColor="@color/text_dark_secondary"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="155 Kwh"
                    android:textColor="@color/text_dark_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="24dp">

            <!-- Device 3: Livingroom Substation (Highlighted Electric Yellow Card) -->
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="115dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_yellow_card"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/ivLivingroom"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_livingroom"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_refresh_arrow"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:alpha="0.75" />

                <TextView
                    android:id="@+id/tvLivingroomLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/ivLivingroom"
                    android:text="Livingroom"
                    android:textColor="@color/text_dark_secondary"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvLivingroomLabel"
                    android:text="198 Kwh"
                    android:textColor="@color/text_dark_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit"
                    android:layout_marginTop="2dp" />
            </RelativeLayout>

            <!-- Device 4: CCTV / Monitoring (Cream Card) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="115dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_cream_card"
                android:orientation="vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_camera" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CCTV Camera"
                    android:textColor="@color/text_dark_secondary"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="88 Kwh"
                    android:textColor="@color/text_dark_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Action Primary Banner (Book Slot - Yellow Accent) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dark_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Book Energy Slot"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Schedule trading window on node"
                    android:textColor="@color/text_light_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnBookSlot"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_yellow_pill"
                android:text="Book Slot →"
                android:textColor="@color/text_dark_primary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:fontFamily="@font/outfit"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- Quick Action Secondary (View Bookings & QR Codes) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dark_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Reservations"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all reservations &amp; QR passes"
                    android:textColor="@color/text_light_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnViewBookings"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_pill_dark"
                android:text="View History →"
                android:textColor="@color/yellow_primary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:fontFamily="@font/outfit"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- Live Sync Refresh Button -->
        <Button
            android:id="@+id/btnRefreshStats"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_pill_dark"
            android:text="↻  Sync Live Microgrid Metrics"
            android:textColor="@color/text_light_secondary"
            android:textSize="12sp"
            android:fontFamily="@font/outfit"
            app:backgroundTint="@null" />

    </LinearLayout>
</ScrollView>

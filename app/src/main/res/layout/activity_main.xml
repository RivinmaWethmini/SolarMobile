<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="42dp">

        <!-- =================================================================== -->
        <!-- TOP HEADER: Emblem + Greeting + Live Online Badge + Sign Out        -->
        <!-- =================================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Emblem Frame -->
            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_dark_input"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_solar_logo"
                    android:contentDescription="SolarRays Emblem" />
            </FrameLayout>

            <!-- Greeting & User / Role -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SolarRays • Platform"
                        android:textColor="@color/yellow_primary"
                        android:textSize="11sp"
                        android:letterSpacing="0.04"
                        android:fontFamily="@font/outfit_bold" />

                    <!-- Live Online Status Indicator -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_dark"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_circle_yellow"
                            android:backgroundTint="@color/emerald_approved" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Online"
                            android:textColor="@color/emerald_approved"
                            android:textSize="10sp"
                            android:fontFamily="@font/outfit_bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- User Name & Role Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="3dp">

                    <TextView
                        android:id="@+id/tvUserNic"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Solar Participant"
                        android:textColor="@color/text_white"
                        android:textSize="16sp"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/outfit_bold" />

                    <TextView
                        android:id="@+id/tvUserRoleBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="☀️ Participant"
                        android:textColor="@color/yellow_primary"
                        android:textSize="10sp"
                        android:fontFamily="@font/outfit_bold"
                        android:background="@drawable/bg_pill_dark"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Refresh & Logout Header Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnRefreshStats"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_refresh_arrow"
                    android:background="@drawable/bg_pill_dark"
                    android:padding="8dp"
                    app:tint="@color/yellow_primary"
                    android:contentDescription="Refresh Telemetry"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageView
                    android:id="@+id/btnHeaderLogout"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_logout"
                    android:background="@drawable/bg_pill_dark"
                    android:padding="9dp"
                    app:tint="@color/text_light_secondary"
                    android:contentDescription="Sign Out"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- =================================================================== -->
        <!-- HERO CARD: Live Solar (4.8 kW) + Battery (86%) + Today (32.1 kWh)   -->
        <!-- =================================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_card"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <!-- Card Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ LIVE MICROGRID TELEMETRY"
                    android:textColor="@color/yellow_primary"
                    android:textSize="11sp"
                    android:letterSpacing="0.06"
                    android:fontFamily="@font/outfit_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phase Sync • 50.0 Hz"
                    android:textColor="@color/emerald_approved"
                    android:textSize="10sp"
                    android:fontFamily="@font/outfit_semibold"
                    android:background="@drawable/bg_pill_dark"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>

            <!-- 3-Pillar Telemetry Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 1. Live Solar Generation (4.8 kW) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dark_input"
                    android:padding="12dp"
                    android:layout_marginEnd="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Solar Output"
                        android:textColor="@color/text_light_muted"
                        android:textSize="10sp"
                        android:fontFamily="@font/outfit" />

                    <TextView
                        android:id="@+id/tvHeroSolarKw"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="4.8 kW"
                        android:textColor="@color/yellow_primary"
                        android:textSize="17sp"
                        android:fontFamily="@font/outfit_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="☀️ Peak Gen"
                        android:textColor="@color/emerald_approved"
                        android:textSize="9sp"
                        android:fontFamily="@font/outfit_medium" />
                </LinearLayout>

                <!-- 2. Circular Battery Gauge (86% Charged) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dark_input"
                    android:padding="12dp"
                    android:gravity="center_horizontal"
                    android:layout_marginHorizontal="3dp">

                    <!-- Visual Battery Ring / Gauge Frame -->
                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_circular_gauge" />

                        <TextView
                            android:id="@+id/tvHeroBatteryPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="86%"
                            android:textColor="@color/text_white"
                            android:textSize="12sp"
                            android:fontFamily="@font/outfit_bold" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Battery Storage"
                        android:textColor="@color/text_light_muted"
                        android:textSize="10sp"
                        android:fontFamily="@font/outfit" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔋 86% Charged"
                        android:textColor="@color/emerald_approved"
                        android:textSize="9sp"
                        android:fontFamily="@font/outfit_medium" />
                </LinearLayout>

                <!-- 3. Today's Yield (32.1 kWh) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_dark_input"
                    android:padding="12dp"
                    android:layout_marginStart="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's Yield"
                        android:textColor="@color/text_light_muted"
                        android:textSize="10sp"
                        android:fontFamily="@font/outfit" />

                    <TextView
                        android:id="@+id/tvHeroTodayYield"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="32.1 kWh"
                        android:textColor="@color/text_white"
                        android:textSize="17sp"
                        android:fontFamily="@font/outfit_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="📈 +14% vs avg"
                        android:textColor="@color/yellow_primary"
                        android:textSize="9sp"
                        android:fontFamily="@font/outfit_medium" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- =================================================================== -->
        <!-- SECTION TITLE: ACTION GRID                                          -->
        <!-- =================================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OPERATIONS &amp; SERVICES"
                android:textColor="@color/text_light_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:fontFamily="@font/outfit_bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4 Core Actions"
                android:textColor="@color/text_light_muted"
                android:textSize="11sp"
                android:fontFamily="@font/outfit" />
        </LinearLayout>

        <!-- =================================================================== -->
        <!-- ACTION GRID: 2x2 Clean Cyber-Energy Layout                         -->
        <!-- =================================================================== -->
        <!-- Row 1: Action 1 (Book Slot) & Action 2 (My Reservations) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Card 1: Book Energy Slot (7-day rule) -->
            <LinearLayout
                android:id="@+id/btnBookSlot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_action_card"
                android:padding="16dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_dark_input"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_energy_bolt"
                            app:tint="@color/yellow_primary"
                            android:contentDescription="Book Slot" />
                    </FrameLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7-Day"
                        android:textColor="@color/yellow_primary"
                        android:textSize="10sp"
                        android:fontFamily="@font/outfit_bold"
                        android:background="@drawable/bg_pill_dark"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Book Energy Slot"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Reserve trading slot with 7-day rule check"
                    android:textColor="@color/text_light_secondary"
                    android:textSize="11sp"
                    android:lineSpacingMultiplier="1.1"
                    android:fontFamily="@font/outfit" />
            </LinearLayout>

            <!-- Card 2: My Reservations (12h rule) -->
            <LinearLayout
                android:id="@+id/btnViewBookings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_action_card"
                android:padding="16dp"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_dark_input"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_calendar_slot"
                            app:tint="@color/emerald_approved"
                            android:contentDescription="Reservations" />
                    </FrameLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Queue"
                        android:textColor="@color/emerald_approved"
                        android:textSize="10sp"
                        android:fontFamily="@font/outfit_bold"
                        android:background="@drawable/bg_pill_dark"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Reservations"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Active bookings, history &amp; 12h cancellation"
                    android:textColor="@color/text_light_secondary"
                    android:textSize="11sp"
                    android:lineSpacingMultiplier="1.1"
                    android:fontFamily="@font/outfit" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Action 3 (Microgrid Nodes) & Action 4 (Operator QR Scanner) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <!-- Card 3: Microgrid Nodes -->
            <LinearLayout
                android:id="@+id/btnViewNodes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_action_card"
                android:padding="16dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_dark_input"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_grid_nodes"
                            app:tint="#38BDF8"
                            android:contentDescription="Nodes" />
                    </FrameLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grid"
                        android:textColor="#38BDF8"
                        android:textSize="10sp"
                        android:fontFamily="@font/outfit_bold"
                        android:background="@drawable/bg_pill_dark"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Microgrid Nodes"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Explore connected solar substations &amp; slots"
                    android:textColor="@color/text_light_secondary"
                    android:textSize="11sp"
                    android:lineSpacingMultiplier="1.1"
                    android:fontFamily="@font/outfit" />
            </LinearLayout>

            <!-- Card 4: Operator QR Scanner -->
            <LinearLayout
                android:id="@+id/btnOperatorScan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_action_card"
                android:padding="16dp"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_dark_input"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/yellow_primary"
                            android:contentDescription="Operator Scanner" />
                    </FrameLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scan"
                        android:textColor="@color/yellow_primary"
                        android:textSize="10sp"
                        android:fontFamily="@font/outfit_bold"
                        android:background="@drawable/bg_pill_dark"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Operator Scanner"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Camera scanner for physical energy dispatch"
                    android:textColor="@color/text_light_secondary"
                    android:textSize="11sp"
                    android:lineSpacingMultiplier="1.1"
                    android:fontFamily="@font/outfit" />
            </LinearLayout>
        </LinearLayout>

        <!-- =================================================================== -->
        <!-- CONTEXTUAL CARD: PROSUMER HARDWARE SPECS (Manuga Prosumer Module)   -->
        <!-- =================================================================== -->
        <LinearLayout
            android:id="@+id/btnProsumerProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dark_card"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="☀️ Prosumer Solar Registry"
                    android:textColor="@color/yellow_primary"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View / Edit Specs ›"
                    android:textColor="@color/yellow_primary"
                    android:textSize="11sp"
                    android:fontFamily="@font/outfit_semibold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage your connected solar hardware array, battery storage capacity (kWh), listed trading tariff, and deactivation status."
                android:textColor="@color/text_light_secondary"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.2"
                android:fontFamily="@font/outfit" />
        </LinearLayout>

        <!-- =================================================================== -->
        <!-- BOTTOM INDICATOR CARD: Next Upcoming Confirmed Energy Slot          -->
        <!-- =================================================================== -->
        <LinearLayout
            android:id="@+id/cardNextSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_confirmed_slot_card"
            android:padding="18dp"
            android:layout_marginBottom="22dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ NEXT CONFIRMED ENERGY SLOT"
                    android:textColor="@color/yellow_primary"
                    android:textSize="11sp"
                    android:letterSpacing="0.06"
                    android:fontFamily="@font/outfit_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ CONFIRMED PASS"
                    android:textColor="@color/emerald_approved"
                    android:textSize="10sp"
                    android:fontFamily="@font/outfit_bold"
                    android:background="@drawable/bg_pill_dark"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>

            <!-- Slot Station & Timing Information -->
            <TextView
                android:id="@+id/tvNextSlotNode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Colombo Central Grid Substation (Station-01)"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:fontFamily="@font/outfit_bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tvNextSlotDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today, Active"
                    android:textColor="@color/text_light_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textColor="@color/text_light_muted" />

                <TextView
                    android:id="@+id/tvNextSlotTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14:00 - 16:00 (Slot #3)"
                    android:textColor="@color/yellow_primary"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_semibold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textColor="@color/text_light_muted" />

                <TextView
                    android:id="@+id/tvNextSlotEnergy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25.0 kWh"
                    android:textColor="@color/emerald_approved"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit_bold" />
            </LinearLayout>

            <!-- Quick Action: VIEW QR PASS Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNextSlotQr"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="VIEW QR DISPATCH PASS"
                android:textAllCaps="false"
                android:textColor="@color/bg_black"
                android:textSize="13sp"
                android:fontFamily="@font/outfit_bold"
                android:background="@drawable/btn_solar_gold"
                android:elevation="4dp"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- =================================================================== -->
        <!-- LIVE CONNECTED SUBSTATIONS LIST PREVIEW                             -->
        <!-- =================================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Active Solar Stations"
                android:textColor="@color/text_light_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:fontFamily="@font/outfit_bold" />

            <TextView
                android:id="@+id/tvNodesCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 Online"
                android:textColor="@color/emerald_approved"
                android:textSize="11sp"
                android:fontFamily="@font/outfit_semibold"
                android:background="@drawable/bg_pill_dark"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />
        </LinearLayout>

        <!-- Active Nodes Dynamic Container -->
        <LinearLayout
            android:id="@+id/layoutNodesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <!-- =================================================================== -->
        <!-- HIDDEN COMPATIBILITY VIEWS (Preserve all existing Java references)  -->
        <!-- =================================================================== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <TextView android:id="@+id/tvPendingCount" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/tvApprovedFutureCount" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/tvTotalCount" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/tvActiveNodesCount" android:layout_width="0dp" android:layout_height="0dp" />

            <TextView android:id="@+id/tabRoleProsumer" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/tabRoleOperator" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/tabRoleConsumer" android:layout_width="0dp" android:layout_height="0dp" />
            <TextView android:id="@+id/tabRoleAdmin" android:layout_width="0dp" android:layout_height="0dp" />

            <LinearLayout android:id="@+id/layoutViewProsumer" android:layout_width="0dp" android:layout_height="0dp" />
            <LinearLayout android:id="@+id/layoutViewOperator" android:layout_width="0dp" android:layout_height="0dp" />
            <LinearLayout android:id="@+id/layoutViewConsumer" android:layout_width="0dp" android:layout_height="0dp" />
            <LinearLayout android:id="@+id/layoutViewAdmin" android:layout_width="0dp" android:layout_height="0dp" />
            <LinearLayout android:id="@+id/layoutOperatorScan" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

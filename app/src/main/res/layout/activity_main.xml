<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="36dp">

        <!-- Top Header Bar (Avatar + Dynamic Greeting + Notification Bell) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <!-- Profile Avatar & Greeting -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:src="@drawable/ic_solar_logo"
                    android:contentDescription="Solar Microgrid Logo" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome"
                        android:textColor="@color/text_light_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit" />

                    <TextView
                        android:id="@+id/tvUserNic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prosumer Portal"
                        android:textColor="@color/text_white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/outfit"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Notification Bell Icon Button with Indicator -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_dark">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/text_white" />

                <!-- Notification Dot -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_circle_yellow" />
            </FrameLayout>
        </RelativeLayout>

        <!-- Editorial Hero Image Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/ivHero"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/hero_solar_microgrid"
                android:contentDescription="Solar microgrid installation" />

            <!-- Bottom-up dark scrim -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_hero_scrim" />

            <!-- Text overlay anchored to bottom -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Energy Reservations"
                    android:textColor="@color/text_white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage upcoming energy slots and dispatch approvals."
                    android:textColor="@color/text_light_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Live Reservation Operational Metrics (2x2 Grid) -->
        <!-- Row 1: Pending & Approved -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="12dp">

            <!-- Pending Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="@color/bg_dark_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvPendingCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/yellow_primary"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/outfit" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending Action"
                        android:textColor="@color/text_light_secondary"
                        android:textSize="11sp"
                        android:fontFamily="@font/outfit"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Approved Future Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="@color/bg_dark_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvApprovedFutureCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/emerald_approved"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/outfit" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Approved Slots"
                        android:textColor="@color/text_light_secondary"
                        android:textSize="11sp"
                        android:fontFamily="@font/outfit"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 2: Total Bookings & Active Nodes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="24dp">

            <!-- Total Bookings Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="@color/bg_dark_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvTotalCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_white"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/outfit" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Bookings"
                        android:textColor="@color/text_light_secondary"
                        android:textSize="11sp"
                        android:fontFamily="@font/outfit"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Connected Nodes Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="@color/bg_dark_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvActiveNodesCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/yellow_primary"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/outfit" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connected Nodes"
                        android:textColor="@color/text_light_secondary"
                        android:textSize="11sp"
                        android:fontFamily="@font/outfit"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Next Approved Slot Card (Dynamic from API, hidden if none) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardNextSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/bg_dark_card"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Left Emerald Status Indicator -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@color/emerald_approved" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Upcoming Dispatch Slot"
                            android:textColor="@color/emerald_approved"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/outfit" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Approved"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/outfit"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:background="@drawable/bg_status_pill" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvNextSlotNode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Colombo North Hub"
                        android:textColor="@color/text_white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/outfit" />

                    <TextView
                        android:id="@+id/tvNextSlotDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mon, 25 Sep 2026"
                        android:textColor="@color/text_light_secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit"
                        android:layout_marginTop="2dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNextSlotTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="09:00 – 11:00"
                                android:textColor="@color/text_light_primary"
                                android:textSize="13sp"
                                android:fontFamily="@font/outfit" />

                            <TextView
                                android:id="@+id/tvNextSlotEnergy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="25.0 kWh"
                                android:textColor="@color/yellow_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/outfit"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnNextSlotQr"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_yellow_pill"
                            android:text="View QR Pass →"
                            android:textColor="@color/text_dark_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/outfit"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            app:backgroundTint="@null" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Microgrid Trading Nodes Section (100% Dynamic from API) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Microgrid Trading Nodes"
                android:textColor="@color/text_white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/outfit" />

            <TextView
                android:id="@+id/tvNodesCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Live Grid"
                android:textColor="@color/yellow_primary"
                android:textSize="12sp"
                android:fontFamily="@font/outfit" />
        </RelativeLayout>

        <!-- Dynamic Container for Live Nodes from API -->
        <LinearLayout
            android:id="@+id/layoutNodesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp" />

        <!-- Quick Action Primary Banner (Book Slot - Yellow Accent) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dark_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Book Energy Slot"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Schedule trading window on node"
                    android:textColor="@color/text_light_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnBookSlot"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_yellow_pill"
                android:text="Book Slot →"
                android:textColor="@color/text_dark_primary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:fontFamily="@font/outfit"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- Quick Action Secondary (View Bookings & QR Codes) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dark_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Reservations"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all reservations &amp; QR passes"
                    android:textColor="@color/text_light_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnViewBookings"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_pill_dark"
                android:text="View History →"
                android:textColor="@color/yellow_primary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:fontFamily="@font/outfit"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- Operator QR Scanner (Member 4 - Energy Dispatch Verification) -->
        <LinearLayout
            android:id="@+id/layoutOperatorScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dark_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Operator QR Scan"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verify &amp; authorize prosumer dispatch"
                    android:textColor="@color/text_light_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnOperatorScan"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_pill_dark"
                android:text="Scan QR →"
                android:textColor="@color/yellow_primary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:fontFamily="@font/outfit"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- Microgrid Nodes (Member 3 - Active Solar Stations) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dark_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active Solar Nodes"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Explore grid stations &amp; capacities"
                    android:textColor="@color/text_light_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnViewNodes"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_pill_dark"
                android:text="View Nodes →"
                android:textColor="@color/yellow_primary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:fontFamily="@font/outfit"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- Live Sync Refresh Button -->
        <Button
            android:id="@+id/btnRefreshStats"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_pill_dark"
            android:text="Sync Live Metrics"
            android:textColor="@color/text_light_secondary"
            android:textSize="12sp"
            android:fontFamily="@font/outfit"
            app:backgroundTint="@null" />

    </LinearLayout>
</ScrollView>

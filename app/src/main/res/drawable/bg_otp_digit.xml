<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#26FFD000" />
            <stroke android:width="2dp" android:color="@color/yellow_primary" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_dark_surface" />
            <stroke android:width="1dp" android:color="@color/bg_dark_card_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4D000000">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/yellow_dark" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#FFE57F" />
                </shape>
            </item>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="#2A2A30" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#FFD500"
                        android:endColor="#FFBF00"
                        android:angle="270" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#FFE880" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

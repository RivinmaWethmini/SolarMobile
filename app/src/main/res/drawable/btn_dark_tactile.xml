<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFD000">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="#20222B" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1.2dp" android:color="@color/yellow_primary" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#14151A" />
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#282932" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_solar_logo"
        android:roundIcon="@drawable/ic_solar_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SolarMicrogrid"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".ui.BookingActivity"
            android:exported="false"
            android:label="Reserve Energy Slot"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.ModifyBookingActivity"
            android:exported="false"
            android:label="Modify Reservation"
            android:parentActivityName=".ui.BookingSummaryActivity" />

        <activity
            android:name=".ui.BookingSummaryActivity"
            android:exported="false"
            android:label="Booking Summary"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.QrDisplayActivity"
            android:exported="false"
            android:label="Dispatch QR Code"
            android:parentActivityName=".ui.BookingListActivity" />

        <activity
            android:name=".ui.BookingListActivity"
            android:exported="false"
            android:label="My Energy Reservations"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.NodeListActivity"
            android:exported="false"
            android:label="Active Solar Nodes"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.NodeDetailsActivity"
            android:exported="false"
            android:label="Solar Node Details"
            android:parentActivityName=".ui.NodeListActivity" />

        <activity
            android:name=".ui.OperatorScanActivity"
            android:exported="false"
            android:label="Operator QR Scan"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.ProsumerProfileActivity"
            android:exported="false"
            android:label="Prosumer Profile"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.EditProsumerActivity"
            android:exported="false"
            android:label="Edit Prosumer Profile"
            android:parentActivityName=".ui.ProsumerProfileActivity" />

        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:label="Welcome to Solis" />

        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:label="Sign In" />

        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false"
            android:label="Create Account" />

    </application>

</manifest>
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions for RESTful Web API connectivity -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Camera permission for QR scanning if operator mode is utilized -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SolarMicrogrid"
        android:usesCleartextTraffic="true">

        <!-- Main Dashboard Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Member 4: Energy Slot Booking Screen (Node & Date Picker) -->
        <activity
            android:name=".ui.BookingActivity"
            android:exported="false"
            android:label="Reserve Energy Slot"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Member 4: Booking Summary Screen (Shown after each action) -->
        <activity
            android:name=".ui.BookingSummaryActivity"
            android:exported="false"
            android:label="Booking Summary"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Member 4: ZXing QR Code Display for Approved Bookings -->
        <activity
            android:name=".ui.QrDisplayActivity"
            android:exported="false"
            android:label="Dispatch QR Code"
            android:parentActivityName=".ui.BookingListActivity" />

        <!-- Current / Pending Bookings and History Screen with Search Filter -->
        <activity
            android:name=".ui.BookingListActivity"
            android:exported="false"
            android:label="My Energy Reservations"
            android:parentActivityName=".ui.MainActivity" />

    </application>

</manifest>

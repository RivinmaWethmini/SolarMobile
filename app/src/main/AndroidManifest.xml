<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions for RESTful Web API connectivity -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Camera permission for QR scanning if operator mode is utilized -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_solar_logo"
        android:roundIcon="@drawable/ic_solar_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SolarMicrogrid"
        android:usesCleartextTraffic="true">


        <!-- Main Dashboard Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Energy Slot Booking Screen (Node & Date Picker) -->
        <activity
            android:name=".ui.BookingActivity"
            android:exported="false"
            android:label="Reserve Energy Slot"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Energy Slot Modification Screen -->
        <activity
            android:name=".ui.ModifyBookingActivity"
            android:exported="false"
            android:label="Modify Reservation"
            android:parentActivityName=".ui.BookingSummaryActivity" />

        <!-- Booking Summary Screen -->
        <activity
            android:name=".ui.BookingSummaryActivity"
            android:exported="false"
            android:label="Booking Summary"
            android:parentActivityName=".ui.MainActivity" />

        <!-- QR Code Display for Approved Bookings -->
        <activity
            android:name=".ui.QrDisplayActivity"
            android:exported="false"
            android:label="Dispatch QR Code"
            android:parentActivityName=".ui.BookingListActivity" />

        <!-- Reservations List Screen -->
        <activity
            android:name=".ui.BookingListActivity"
            android:exported="false"
            android:label="My Energy Reservations"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Microgrid Node List Screen (Member 3 - Avishka) -->
        <activity
            android:name=".ui.NodeListActivity"
            android:exported="false"
            android:label="Active Solar Nodes"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Microgrid Node Details Screen (Member 3 - Avishka) -->
        <activity
            android:name=".ui.NodeDetailsActivity"
            android:exported="false"
            android:label="Node Details"
            android:parentActivityName=".ui.NodeListActivity" />

        <!-- Operator QR Scanner Screen (Member 4 - Energy Dispatch Verification) -->
        <activity
            android:name=".ui.OperatorScanActivity"
            android:exported="false"
            android:label="Operator QR Scan"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.MainActivity" />

    </application>

</manifest>

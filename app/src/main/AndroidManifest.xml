<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions for REST API connectivity -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera permission for QR scanning -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SolarMicrogrid"
        android:usesCleartextTraffic="true">

        <!-- Main Dashboard Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Member 3: Active Solar Nodes List -->
        <activity
            android:name=".ui.NodeListActivity"
            android:exported="false"
            android:label="Active Solar Nodes"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Member 4: Energy Slot Booking -->
        <activity
            android:name=".ui.BookingActivity"
            android:exported="false"
            android:label="Reserve Energy Slot"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Member 4: Booking List and History -->
        <activity
            android:name=".ui.BookingListActivity"
            android:exported="false"
            android:label="My Energy Reservations"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Member 4: Booking Summary -->
        <activity
            android:name=".ui.BookingSummaryActivity"
            android:exported="false"
            android:label="Booking Summary"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Member 4: QR Code Display -->
        <activity
            android:name=".ui.QrDisplayActivity"
            android:exported="false"
            android:label="Dispatch QR Code"
            android:parentActivityName=".ui.BookingListActivity" />

        <activity
            android:name=".ui.NodeDetailsActivity"
            android:exported="false"
            android:label="Solar Node Details"
            android:parentActivityName=".ui.NodeListActivity" />

    </application>

</manifest>